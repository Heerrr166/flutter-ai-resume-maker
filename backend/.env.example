PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumeforge?retryWrites=true&w=majority
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super-secret-refresh-key
REFRESH_TOKEN_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins for CORS (native/mobile
# clients are unaffected by this setting). Leave unset in development to
# allow any origin; set explicitly before deploying to production.
CLIENT_URL=http://localhost:3000

# Optional: set both to auto-create an admin account on server startup.
# Leave unset to skip admin seeding entirely.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-your-local-env-only
ADMIN_FULL_NAME=Admin User
ADMIN_PHONE=+10000000000

# Optional. /api/ai/* (summary/experience/project/achievement rewriting, JD
# analysis, resume/job matching, tailoring, review, career insights,
# interview prep, cover letters) uses Gemini for the natural-language tasks
# when this is set, and always falls back to the local, zero-cost Resume
# Intelligence Engine (backend/services/resumeIntelligenceEngine.js) if it's
# unset, misconfigured, rate-limited, times out, or returns something
# unusable. Deterministic tasks (ATS score, literal keyword matching, skill
# recommendations) always run locally regardless of this setting. Get a key
# from Google AI Studio (aistudio.google.com/apikey). Never commit this file
# with a real key filled in - only backend/.env, which is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Dormant. The old Anthropic-backed wrapper (backend/services/aiClient.js)
# is unused now that the provider layer talks to Gemini
# (backend/services/providers/geminiProvider.js) - kept only so it isn't
# lost; harmless to leave unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
